{
  "include": [
    "tray.jsonc"
  ],
  "name": "river-bar",
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "height": 32,
  "spacing": 0,
  "modules-left": [
    "dwl/tags"
  ],
  "modules-center": [
    "dwl/window"
  ],
  "modules-right": [
    "group/tray-drawer",
    "custom/status"
  ],
  "river/tags": {
    "num-tags": 9,
    "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9"],
    "disable-click": false,
    "hide-vacant": false
  },
  "group/tray-drawer": {
    "orientation": "inherit",
    "drawer": {
      "click-to-reveal": true,
      "transition-duration": 160,
      "children-class": "tray-child",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/tray-toggle",
      "tray"
    ]
  },
  "custom/tray-toggle": {
    "exec": "sh -c 'exec \"$HOME/.config/waybar/tray-state.sh\" json'",
    "return-type": "json",
    "interval": 2,
    "signal": 9,
    "on-click-release": "sh -c 'exec \"$HOME/.config/waybar/tray-toggle.sh\"'",
    "hide-empty-text": true,
    "tooltip": false
  },
  "river/window": {
    "format": "{}",
    "max-length": 120
  },
  "custom/status": {
    "exec": "sh -c 'exec \"$HOME/.config/waybar/status.sh\"'",
    "interval": 0.2,
    "signal": 10,
    "format": "{text}",
    "escape": false,
    "tooltip": false
  }
}
