{
  "name": "mango-bar",
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "height": 32,
  "spacing": 0,
  "modules-left": [
    "dwl/tags"
  ],
  "modules-center": [
    "dwl/window"
  ],
  "modules-right": [
    "group/tray-drawer",
    "custom/status"
  ],
  "group/tray-drawer": {
    "orientation": "inherit",
    "drawer": {
      "click-to-reveal": true,
      "transition-duration": 160,
      "children-class": "tray-child",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/tray-toggle",
      "tray"
    ]
  },
  "custom/tray-toggle": {
    "exec": "printf '⋮\\n'",
    "interval": "once",
    "format": "{}",
    "tooltip": false
  },
  "tray": {
    "icon-size": 18,
    "spacing": 6,
    "show-passive-items": true
  },
  "custom/status": {
    "exec": "sh -c 'exec \"$HOME/.config/waybar/status.sh\"'",
    "interval": 5,
    "signal": 10,
    "format": "{text}",
    "escape": false,
    "tooltip": false
  }
}
